# Voice assistant — template (safe to commit, no secrets here)
# Copy to .env and fill in your key, then restart uvicorn.
# Put this file at the REPO ROOT (next to package.json).
# Voice parse (speech understanding) uses Groq:
# https://console.groq.com/keys — value starts with gsk_, no quotes, no spaces.
GROQ_API_KEY=
# Voice playback (TTS) is local (browser Web Speech API, English voice) —
# no TTS key needed.

# Frontend → backend base URL (used by voiceService; dev proxy covers /api)
VITE_API_BASE_URL=http://localhost:8000

# Voice assistant bubble kill switch (default OFF). Set to exactly 'true' to
# show the bubble. Restart `npm run dev` after changing (Vite injects at start).
VITE_VOICE_ASSISTANT_ENABLED=false
