{
  "name": "autotransat-qc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"uvicorn backend.main:app --reload --port 8000\"",
    "dev:web": "vite",
    "dev:api": "uvicorn backend.main:app --reload --port 8000",
    "setup": "npm install && pip install -r backend/requirements.txt",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx test_calculations.ts && tsx tests/e2e-prefill.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
