{
  "name": "autotransat-qc-marketplace-extension",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "Extension Chrome/Edge MV3 AutoTransat QC — estimation du coût rendu Dakar/Casablanca sur Facebook Marketplace. Calcul 100 % local via moteur versionné.",
  "scripts": {
    "sync:extension-engine": "node scripts/sync-engine.mjs",
