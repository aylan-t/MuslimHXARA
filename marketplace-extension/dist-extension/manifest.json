{
  "manifest_version": 3,
  "name": "QCar export — Estimation sur Facebook Marketplace",
  "short_name": "QCar export",
  "version": "1.3.1",
  "description": "Affiche une estimation locale du coût rendu (Dakar/Casablanca) et du profit net sur les annonces véhicules Facebook Marketplace. Calcul 100 % local, aucun chiffre inventé.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QCar export — logs & version"
  },
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://vpic.nhtsa.dot.gov/api/vehicles/*",
    "https://carapi.app/*"
  ],
  "optional_host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/marketplace/item/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
